<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="VTiger_Sequential_CrossBrowser_Suite" parallel="none">

  <!-- ================= 1. Chrome Execution (Runs First) ================= -->
  <test name="Chrome_Execution">
    <parameter name="browser" value="chrome" />
    <classes>
      <class name="CRM_Vtiger_BITM_Login_HomePage.CRM_Vtiger_BITM_LoginHomePage_Test" />
      <class name="CRM_Vtiger_BITM_Projects.CRM_Vtiger_BITM_ProjectsTest" />
      <class name="CRM_Vtiger_BITM_ProjectTasks.CRM_Vtiger_BITM_ProjectTasksTest" />
      <class name="CRM_Vtiger_BITM_ProjectMilestones.CRM_Vtiger_BITM_ProjectMilestonesTest" />
      <class name="CRM_Vtiger_BITM_FAQ.CRM_Vtiger_BITM_FAQTest" />
      <class name="CRM_Vtiger_BITM_ServiceContracts.CRM_Vtiger_BITM_ServiceContractsTest" />
      
    </classes>
  </test>

  <!-- ================= 2. Edge Execution (Starts After Chrome Completes) ================= -->
  <test name="Edge_Execution">
    <parameter name="browser" value="edge" />
    <classes>
      <class name="CRM_Vtiger_BITM_Login_HomePage.CRM_Vtiger_BITM_LoginHomePage_Test" />
      <class name="CRM_Vtiger_BITM_Projects.CRM_Vtiger_BITM_ProjectsTest" />
      <class name="CRM_Vtiger_BITM_ProjectTasks.CRM_Vtiger_BITM_ProjectTasksTest" />
      <class name="CRM_Vtiger_BITM_ProjectMilestones.CRM_Vtiger_BITM_ProjectMilestonesTest" />
        <class name="CRM_Vtiger_BITM_FAQ.CRM_Vtiger_BITM_FAQTest" />
      <class name="CRM_Vtiger_BITM_ServiceContracts.CRM_Vtiger_BITM_ServiceContractsTest" />
    
    </classes>
  </test>

</suite>